<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs idle-reaper.py once a minute: it turns off the simulators and local servers that
     Claude sessions started and then left idle. `running` shows what it sees.
     Written by Claude Code Idle Reaper's install.sh, which also removes it on uninstall.
     By hand: launchctl bootout gui/$(id -u)/local.idle-reaper, then delete this file. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.idle-reaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{SCRIPT}}</string>
        <string>tick</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DEVELOPER_DIR</key>
        <string>{{DEVELOPER_DIR}}</string>{{EXTRA_ENV}}
    </dict>
    <key>StandardOutPath</key>
    <string>{{LAUNCHD_LOG}}</string>
    <key>StandardErrorPath</key>
    <string>{{LAUNCHD_LOG}}</string>
</dict>
</plist>
